{
  "name": "lotus",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "A calm Markdown workspace for vaults, folders, and notes.",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node scripts/smoke-lotus-0120.mjs",
    "smoke:browser": "node scripts/smoke-browser-tabs.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src scripts README.md package.json",
    "package:win": "tauri build --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "^2",
    "@uiw/react-codemirror": "^4.23.13",
    "dompurify": "^3.4.15",
    "js-yaml": "^4.1.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.544.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
